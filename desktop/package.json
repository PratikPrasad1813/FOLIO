{
  "name": "folio-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.folio.workspace",
    "productName": "Folio",
    "protocols": {
      "name": "Folio URL",
      "schemes": ["folio"]
    },
    "win": {
      "target": "nsis"
    }
  }
}
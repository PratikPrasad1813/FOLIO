{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "1.0.0",
  "identifier": "com.folio.workspace",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Folio - Management Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Folio",
    "copyright": "Copyright © 2026 Folio. All rights reserved.",
    "shortDescription": "Folio - Management Studio and Personal Workspace",
    "longDescription": "A thoughtful local-first desktop workspace for your projects, tasks, ideas, schedules, and Folio AI. Features a local SQLite engine for full offline capability with silent background cloud sync.",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "license": "installer/TERMS_AND_PRIVACY.txt",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/Square150x150Logo.png",
        "sidebarImage": "icons/Square310x310Logo.png",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "installer/nsis-hooks.nsh"
      },
      "wix": {
        "license": "installer/TERMS_AND_PRIVACY.txt",
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": ["libgtk-3-0", "libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "librsvg2-common"],
        "postRemoveScript": "installer/deb-postrm.sh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["folio"]
      }
    }
  }
}

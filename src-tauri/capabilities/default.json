{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://folio-management-studio.onrender.com"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://folio-management-studio.onrender.com/**"
        },
        {
          "url": "http://localhost:3000/**"
        }
      ]
    }
  ]
}

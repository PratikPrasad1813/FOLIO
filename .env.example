# Folio application database (Neon PostgreSQL or local PostgreSQL)
#
# Option A — Neon PostgreSQL (free tier is enough):
#   1. Create a project at https://neon.tech
#   2. Dashboard → Connect → copy the FULL connection string (includes the password)
#   3. Paste it below, keeping ?sslmode=require at the end.
#      If the password contains special characters, URL-encode them first:
#        @ → %40   # → %23   % → %25   ? → %3F   / → %2F
#   4. Verify it:  npm run db:check
# DATABASE_URL="postgresql://neondb_owner:YOUR-PASSWORD@ep-cool-name-a1b2c3d4.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Option B — local PostgreSQL (must be running):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/folio"

# Canonical origin: REQUIRED in production. Set both to
# https://folio-management-studio.onrender.com on Render; keep localhost for local development.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Long random secret (at least 32 characters); also protects Google Calendar tokens.
FOLIO_ENCRYPTION_KEY="replace-with-a-long-random-secret-at-least-32-characters"

# Folio AI is BYOK: each user supplies their own provider API key (Anthropic,
# OpenAI, OpenRouter, or Google AI Studio) in AI Settings. The server holds no central AI key.

# Optional OAuth providers. Configure callbacks at your Folio APP_URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Transactional email over SMTP with TLS. Any SMTP provider works.
# Resend's SMTP relay (sender must use a domain verified in Resend):
#   SMTP_URL="smtps://resend:re_your_api_key@smtp.resend.com:465"
#   SMTP_FROM="Folio <hello@mail.your-domain.example>"
SMTP_URL=""
SMTP_FROM=""

# Frontend switch for email-dependent UI: verification prompts, "send link" buttons and
# password-recovery entry points. "false" hides or replaces them with a calm notice.
# It does NOT disable the server-side email code. Set "true" once delivery is verified.
# NEXT_PUBLIC_* values are inlined into the browser bundle: never put secrets here.
NEXT_PUBLIC_EMAIL_FEATURES_ENABLED="false"

# Local email preview studio (/dev/emails) is enabled automatically in development.
# Leave unset in production unless explicitly inspecting templates on a private staging build.
FOLIO_EMAIL_PREVIEW=""

# On-demand screenshots ONLY. Leave mode unset for normal development/deployment.
# Set FOLIO_SCREENSHOT_MODE=local and point at a DIFFERENT loopback database.
FOLIO_SCREENSHOT_MODE=""
SCREENSHOT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/folio_screenshots"

# Optional scheduled reminder endpoint secret.
FOLIO_CRON_SECRET=""

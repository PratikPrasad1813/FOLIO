
# Folio application database (Neon PostgreSQL or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/folio"

# Canonical application URL
# Use your HTTPS Netlify URL in production.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encryption key for sensitive stored data, including Google Calendar tokens.
# Generate a secure random value of at least 32 characters for your environment.
FOLIO_ENCRYPTION_KEY="replace-with-a-long-random-secret-at-least-32-characters"

# Optional OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Transactional email via SMTP
SMTP_URL=""
SMTP_FROM=""

# Email-dependent frontend features
NEXT_PUBLIC_EMAIL_FEATURES_ENABLED="false"

# Local email preview studio
FOLIO_EMAIL_PREVIEW=""

# On-demand screenshots only
# Leave unset for normal development and production.
FOLIO_SCREENSHOT_MODE=""
SCREENSHOT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/folio_screenshots"

# Optional scheduled reminder endpoint secret
FOLIO_CRON_SECRET=""
